# Copia este archivo a .env para desarrollo local. Nunca versiones .env.
PORT=3000
DATABASE_URL=postgres://pos:pos@localhost:5432/pos
TEST_DATABASE_URL=postgres://pos:pos@localhost:5432/pos_test

# Origen de la web (único autorizado para solicitudes que modifican datos).
APP_ORIGIN=http://localhost:5173

# Proveedor de identidad LOCAL, solo para desarrollo (no se acepta en producción).
# Los valores de abajo son de ejemplo: cámbialos en tu .env.
AUTH_PROVIDER=local
AUTH_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres
LOCAL_AUTH_USERS=[{"email":"dueno@ejemplo.test","password":"cambia-esta-clave-local"}]
