# Copia este archivo a .env para desarrollo local. Nunca versiones .env.
PORT=3000
DATABASE_URL=postgres://pos@localhost:5432/pos
TEST_DATABASE_URL=postgres://pos@localhost:5432/pos_test

# Origen de la web (único autorizado para solicitudes que modifican datos).
APP_ORIGIN=http://localhost:5173

# Proveedor de identidad LOCAL, solo para desarrollo (no se acepta en producción).
# Genera el secreto con: openssl rand -hex 32
AUTH_PROVIDER=local
AUTH_SECRET=
# Formato: [{"email":"dueno@ejemplo.test","password":"<elige-una-clave>"}]
LOCAL_AUTH_USERS=
