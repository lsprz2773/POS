{
  "name": "@pos/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql --database-url-var DATABASE_URL up",
    "migrate:create": "node ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql create",
    "db:types": "node --env-file-if-exists=../../.env ../../node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --out-file src/db/types.ts --exclude-pattern pgmigrations",
    "provision": "tsx --env-file-if-exists=../../.env src/scripts/provision-tenant.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@pos/shared": "*",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.0",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
